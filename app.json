{
  "expo": {
    "name": "Blog Periférico",
    "slug": "blog-periferico",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/blog-icon.jpg",

    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/blog-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blogperiferico.app"
    },

    "android": {
      "package": "com.blogperiferico.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/blog-icon.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },

    "web": {
      "favicon": "./assets/blog-icon.jpg"
    },

    "plugins": [
      "expo-font"
    ],

    "extra": {
      "eas": {
        "projectId": "2bb9839b-583e-4f03-8ba9-0c9e2f02cd5a"
      }
    }
  }
}
